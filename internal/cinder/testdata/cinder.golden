# HELP openstack_volume_info Volume information; the value is always 1.
# TYPE openstack_volume_info gauge
openstack_volume_info{id="v1",name="data",volume_type="ssd",availability_zone="nova",bootable="false"} 1
openstack_volume_info{id="v2",name="",volume_type="hdd",availability_zone="nova",bootable="true"} 1
openstack_volume_info{id="v3",name="bad",volume_type="ssd",availability_zone="nova",bootable="false"} 1
openstack_volume_info{id="v4",name="growing",volume_type="ssd",availability_zone="nova",bootable="false"} 1
