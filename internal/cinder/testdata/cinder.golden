# TYPE openstack_volume_status gauge
openstack_volume_status{id="v1",status="in-use"} 1
openstack_volume_status{id="v2",status="available"} 1
openstack_volume_status{id="v3",status="error"} 1
openstack_volume_status{id="v4",status="extending"} 1
