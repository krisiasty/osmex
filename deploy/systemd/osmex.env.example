# osmex environment, read by systemd (EnvironmentFile=/etc/osmex/osmex.env).
# Copy the non-secret values from the Horizon application-credential openrc,
# without "export " prefixes: systemd expects plain KEY=VALUE lines.
# Install as root:root with mode 0600.
# The example unit delivers the secret through LoadCredentialEncrypted; do not set
# OS_APPLICATION_CREDENTIAL_SECRET or OS_APPLICATION_CREDENTIAL_SECRET_FILE here.
# Prepare the encrypted credential as described in docs/credentials.md.
OS_AUTH_URL=https://keystone.example.com:5000/v3
OS_APPLICATION_CREDENTIAL_ID=replace-with-credential-id
OS_REGION_NAME=RegionOne
OS_INTERFACE=public
# OS_CACERT=/etc/osmex/ca.pem
